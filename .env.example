# Copia este fichero a .env.local para trabajar en tu ordenador,
# y mete los mismos valores en Vercel → Settings → Environment Variables.
# El .env.local NO se sube nunca al repositorio.

# ─── Supabase (la base de datos) ────────────────────────────────────────
# Panel de Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# La clave "service_role", la secreta. Solo se usa en /api, nunca en el
# navegador. Quien la tenga puede leer y cambiar todas las reservas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Resend (el envío de correos) ───────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx

# De dónde salen los correos. Hasta que no haya un dominio verificado en
# Resend, solo se puede usar onboarding@resend.dev y solo llegan correos
# a la dirección de la cuenta de Resend. Con dominio propio:
#   CORREO_REMITENTE=Plafer Parking <reservas@plafer.com>
CORREO_REMITENTE=Plafer Parking <onboarding@resend.dev>

# ─── Dónde llegan los avisos de reserva nueva ───────────────────────────
CORREO_PLAFER=garatgesplafes@hotmail.com

# ─── Opcional ───────────────────────────────────────────────────────────
# Solo si los enlaces de los correos salen con una dirección rara.
# En Vercel no suele hacer falta.
# SITIO_URL=https://plafer.vercel.app
